# Copie para .env e ajuste
DATABASE_URL=sqlite:///./ubs_facil.db
# Produção: DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/ubs_facil

# Gere um segredo forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRA_MIN=720

TZ_UBS=America/Sao_Paulo
CORS_ORIGINS=*

CHECKIN_ANTES_MIN=120
CHECKIN_DEPOIS_MIN=30
AGENDA_DIAS_A_FRENTE=30

LEMBRETES_ATIVOS=true
LEMBRETES_INTERVALO_SEG=60
# Caminho do JSON da conta de serviço do Firebase (deixe vazio para simular os envios)
FIREBASE_CREDENCIAIS=

LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MIN=15
